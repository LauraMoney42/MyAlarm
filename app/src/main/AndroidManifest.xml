<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Exact alarms. USE_EXACT_ALARM is auto-granted to apps whose core
         function is an alarm clock, which is exactly what this is. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Wake the screen and show over the keyguard when the alarm fires. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <!-- Reschedule alarms after the tablet reboots (it will, eventually). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Sleep sounds keep playing while the screen dims. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Deliberately absent: INTERNET, ACCESS_*_LOCATION, CAMERA, RECORD_AUDIO.
         MVP1 is fully offline and cannot reach the network at all. -->

    <application
        android:name=".AlarmHubApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlarmHub">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Kiosk: the clock is a home screen, so Home always returns here and
             the app cannot be exited by accident. Enabled by default because
             that is the whole point of the device. Shell is not allowed to flip
             a third-party component on Android 13, so it ships enabled rather
             than being switched on later over adb.

             To hand the tablet back to the stock launcher:
               Settings > Apps > Default apps > Home app
             or over adb:
               adb shell cmd package set-home-activity com.android.launcher3/com.android.launcher3.Launcher3QuickStepGo

             Category HOME + DEFAULT only, no LAUNCHER, so this adds no second
             icon to the app drawer. -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Alarms are armed as absolute epoch times derived from a wall
                     clock. Change the zone or the clock and those two stop
                     agreeing, so re-derive them. These three actions are exempt
                     from the implicit-broadcast restrictions. -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Device admin, used only to become device owner so lock task mode can
             hide the system bars for real. Set with:
               adb shell dpm set-device-owner com.kindcode.alarmhub/.kiosk.AdminReceiver
             Released from inside the app via the kiosk toggle in settings. -->
        <receiver
            android:name=".kiosk.AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".audio.SleepAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>
</manifest>
